# ==============================================================================
# Tourist SOS Dashboard - Environment Configuration (.env.example)
# Copy this file to .env and adjust variables as needed for your local or Docker setup.
# ==============================================================================

# Django Core Settings
SECRET_KEY=django-insecure-touristsos-docker-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# MySQL Database Configuration
# When running with Docker Compose:
# - DB_HOST should be the Docker Compose service name: db
# - DB_PORT is the standard MySQL port: 3306
DB_NAME=touristsos_db
DB_USER=tourist_user
DB_PASSWORD=tourist_password
DB_HOST=db
DB_PORT=3306

# MySQL Container Root Password (used during initial container creation)
DB_ROOT_PASSWORD=rootpassword

# Database SSL (False for local Docker container, True for remote cloud databases like Aiven)
DB_SSL=False

