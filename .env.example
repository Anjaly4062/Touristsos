# ==============================================================================
# Tourist SOS Dashboard - Environment Configuration (.env.example)
# Copy this file to .env and configure for your local environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Settings
# ------------------------------------------------------------------------------
SECRET_KEY=django-insecure-touristsos-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------

# OPTION A: Connecting to Aiven MySQL (Cloud Database)
# Enter your actual Aiven MySQL credentials:
# DB_HOST=mysql-xxxx-project.aivencloud.com
# DB_PORT=12345
# DB_NAME=touristsos_db
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_password_here
# DB_SSL=True
# DB_SSL_CA=ca.pem

# OPTION B: Connecting to Local MySQL Server on Windows
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=touristsos_db
# DB_USER=root
# DB_PASSWORD=your_local_password_here
# DB_SSL=False

# Default fallback values (for Docker or local dev):
DB_NAME=touristsos_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_SSL=False
